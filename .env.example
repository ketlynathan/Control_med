# Copie estas variáveis para Vercel → Project Settings → Environment Variables
# (nunca coloque valores reais neste arquivo commitado no git)

# String de conexão do Postgres. Peça ao seu provedor (Neon, Supabase, Vercel Postgres...).
# Formato: postgres://usuario:senha@host:porta/banco?sslmode=require
DATABASE_URL=

# Chave secreta usada para assinar os tokens de login (JWT).
# Gere uma com: openssl rand -base64 48
JWT_SECRET=

# Chave da API da Groq, usada pela função "Interpretar nota" (IA lê texto
# ou foto de um recibo/nota e preenche o lançamento). Sem isso, o app
# funciona normalmente, só esse botão específico não funciona.
# Pegue em: https://console.groq.com/keys
GROQ_API_KEY=
